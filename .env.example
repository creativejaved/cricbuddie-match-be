PORT=8081
NODE_ENV=development

# Dedicated Match Database
MONGODB_URI=mongodb://localhost:27017/cricbuddie_match

# Must match cricbuddie-identity-be JWT_ACCESS_SECRET for stateless JWT verification
JWT_ACCESS_SECRET=your_jwt_access_secret_from_identity_be

# Identity Service Integration
IDENTITY_SERVICE_URL=http://localhost:8080
INTERNAL_API_KEY=your_internal_api_key_from_identity_be

# Frontend URL for generating Team Invite Links & QR Codes
WEB_APP_URL=http://localhost:5173
